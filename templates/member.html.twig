{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_members') }}" class="inline-flex items-center gap-x-1 text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd" />
            </svg>
            Back to members
        </a>

        <div class="mt-4 sm:flex sm:items-center sm:justify-between sm:gap-4">
            <div>
                <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">
                    {{ member.firstName }} {{ member.lastName }}
                </h1>
                {% if member.clubId %}
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Club {{ member.clubId }}</p>
                {% endif %}
            </div>

            {% if member.ranking %}
                <span class="mt-4 inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700 sm:mt-0 dark:bg-indigo-500/10 dark:text-indigo-300">
                    {{ member.ranking }}
                </span>
            {% endif %}
        </div>

        <section class="mt-8 rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-white/10">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Contact information</h2>
            </div>

            {% if contacts is empty %}
                <div class="px-6 py-6">
                    <p class="text-sm text-gray-500 dark:text-gray-400">No contact information available.</p>
                </div>
            {% else %}
                <ul role="list" class="divide-y divide-gray-100 dark:divide-white/10">
                    {% for contact in contacts %}
                        <li class="flex flex-col gap-4 px-6 py-5 sm:flex-row sm:items-start sm:justify-between">
                            <div class="flex items-center gap-x-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-semibold text-white">
                                    {{ contact.name|split(' ')|map(part => part|first)|join('') }}
                                </span>
                                <span class="text-sm font-medium text-gray-900 dark:text-white">{{ contact.name }}</span>
                            </div>

                            <dl class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-3 sm:gap-6">
                                <div>
                                    <dt class="text-gray-500 dark:text-gray-400">Phone</dt>
                                    <dd class="mt-0.5">
                                        <a href="tel:{{ contact.phone|replace({' ': ''}) }}" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">{{ contact.phone }}</a>
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-gray-500 dark:text-gray-400">Email</dt>
                                    <dd class="mt-0.5">
                                        <a href="mailto:{{ contact.email }}" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">{{ contact.email }}</a>
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-gray-500 dark:text-gray-400">Address</dt>
                                    <dd class="mt-0.5 font-medium text-gray-900 dark:text-white">{{ contact.address }}</dd>
                                </div>
                            </dl>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="mt-8">
            <h2 class="text-base font-semibold text-gray-900 dark:text-white">Performance</h2>

            <div class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-3">
                <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-white/10 dark:bg-gray-800">
                    <dt class="text-sm text-gray-500 dark:text-gray-400">Current ranking</dt>
                    <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">{{ performance.currentRanking ?? 'N/A' }}</dd>
                </div>
                <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-white/10 dark:bg-gray-800">
                    <dt class="text-sm text-gray-500 dark:text-gray-400">Current elo</dt>
                    <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">{{ performance.currentElo ?? 'N/A' }}</dd>
                </div>
                <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-white/10 dark:bg-gray-800">
                    <dt class="text-sm text-gray-500 dark:text-gray-400">Estimated ranking</dt>
                    <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">{{ performance.estimatedRanking ?? 'N/A' }}</dd>
                </div>
            </div>

            <div class="mt-6 rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-800">
                <div class="border-b border-gray-200 px-6 py-4 dark:border-white/10">
                    <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Results</h3>
                </div>

                {% if performance.results is empty %}
                    <div class="px-6 py-6">
                        <p class="text-sm text-gray-500 dark:text-gray-400">No results found.</p>
                    </div>
                {% else %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
                            <thead>
                                <tr>
                                    <th scope="col" class="py-3.5 pr-3 pl-6 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Ranking</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Matches won</th>
                                    <th scope="col" class="py-3.5 pr-6 pl-3 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Matches lost</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-white/10">
                                {% for row in performance.results %}
                                    <tr>
                                        <td class="py-3 pr-3 pl-6 text-sm font-medium text-gray-900 dark:text-white">{{ row.ranking }}</td>
                                        <td class="px-3 py-3 text-sm text-gray-700 dark:text-gray-300">{{ row.won }}</td>
                                        <td class="py-3 pr-6 pl-3 text-sm text-gray-700 dark:text-gray-300">{{ row.lost }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
