{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="px-4 sm:px-6 lg:px-8">
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-base font-semibold text-gray-900 dark:text-white">{{ title }}</h1>
                <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">A list of all members of your club.</p>

                {{ form_start(filterForm, {attr: {class: 'mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2'}}) }}
                    <div>
                        {{ form_label(filterForm.name, null, {label_attr: {class: 'block text-sm/6 font-medium text-gray-900 dark:text-gray-100'}}) }}
                        <div class="mt-2">
                            {{ form_widget(filterForm.name, {attr: {class: 'block h-9 w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500', placeholder: 'Search by name'}}) }}
                        </div>
                        {{ form_errors(filterForm.name) }}
                    </div>

                    <div>
                        {{ form_label(filterForm.ranking, null, {label_attr: {class: 'block text-sm/6 font-medium text-gray-900 dark:text-gray-100'}}) }}
                        <div class="mt-2">
                            {{ form_widget(filterForm.ranking, {attr: {class: 'block h-9 w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:focus:outline-indigo-500'}}) }}
                        </div>
                        {{ form_errors(filterForm.ranking) }}
                    </div>

                    <div class="flex items-center gap-3 sm:col-span-2">
                        <button type="submit" class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500">Filter</button>
                        <a href="{{ path('app_members') }}" class="text-sm/6 font-semibold text-gray-600 hover:text-gray-500 dark:text-gray-400 dark:hover:text-gray-300">Clear</a>
                    </div>
                {{ form_end(filterForm, {render_rest: false}) }}
            </div>
        </div>

        {% if members is empty %}
            <div class="mt-8 rounded-md bg-blue-50 p-4 dark:bg-blue-500/10 dark:outline dark:outline-blue-500/20">
                <p class="text-sm text-blue-700 dark:text-blue-300">No members found.</p>
            </div>
        {% else %}
            <div class="mt-8 flow-root">
                <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                        <table class="relative min-w-full divide-y divide-gray-300 dark:divide-white/15">
                            <thead>
                                <tr>
                                    <th scope="col" class="py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-gray-900 sm:pl-0 dark:text-white">#</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">First name</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Last name</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Ranking</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200 dark:divide-white/10">
                                {% for member in members %}
                                    <tr>
                                        <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-gray-900 sm:pl-0 dark:text-white">{{ member.id }}</td>
                                        <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 dark:text-gray-400">
                                            <a href="{{ path('app_member', {id: member.id}) }}" class="font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">{{ member.firstName }}</a>
                                        </td>
                                        <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 dark:text-gray-400">{{ member.lastName }}</td>
                                        <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 dark:text-gray-400">{{ member.ranking }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
