{% extends 'layout.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_calendar') }}" class="inline-flex items-center gap-x-1 text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd" />
            </svg>
            Back to calendar
        </a>

        <div class="mt-4 sm:flex sm:items-start sm:justify-between sm:gap-4">
            <div>
                <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white">
                    {{ match.homeTeam }} <span class="font-normal text-gray-400 dark:text-gray-500">vs</span> {{ match.awayTeam }}
                </h1>
                {% if match.divisionName %}
                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ match.divisionName }}</p>
                {% endif %}
            </div>

            <div class="mt-4 sm:mt-0">
                {% if match.ongoing %}
                    <span class="inline-flex items-center gap-x-1.5 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300">
                        <span class="size-1.5 rounded-full bg-indigo-500"></span>
                        Live
                    </span>
                {% elseif match.past %}
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300">
                        Played
                    </span>
                {% else %}
                    <span class="inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-medium text-blue-700 dark:bg-blue-500/10 dark:text-blue-300">
                        Upcoming
                    </span>
                {% endif %}
            </div>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs dark:border-white/10 dark:bg-gray-800">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Information</h2>
                <dl class="mt-4 space-y-3 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-gray-500 dark:text-gray-400">Date</dt>
                        <dd class="text-right font-medium text-gray-900 dark:text-white">
                            {{ match.dateTime ? match.dateTime|date('l j F Y') : 'To be announced' }}
                        </dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-gray-500 dark:text-gray-400">Time</dt>
                        <dd class="text-right font-medium text-gray-900 dark:text-white">{{ match.displayTime ?? 'To be announced' }}</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-gray-500 dark:text-gray-400">Week</dt>
                        <dd class="text-right font-medium text-gray-900 dark:text-white">{{ match.displayWeekName ?? '—' }}</dd>
                    </div>
                    {% if match.score %}
                        <div class="flex justify-between gap-4">
                            <dt class="text-gray-500 dark:text-gray-400">Score</dt>
                            <dd class="text-right font-mono font-semibold text-gray-900 dark:text-white">{{ match.score }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>

            <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-xs lg:col-span-2 dark:border-white/10 dark:bg-gray-800">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Location</h2>
                {% if match.venueEntry %}
                    <address class="mt-4 space-y-1 text-sm not-italic text-gray-700 dark:text-gray-300">
                        {% if match.venueEntry.street %}
                            <p>{{ match.venueEntry.street }}</p>
                        {% endif %}
                        {% if match.venueEntry.town %}
                            <p>{{ match.venueEntry.town }}</p>
                        {% endif %}
                    </address>
                    {% set venueAddress = [match.venueEntry.street, match.venueEntry.town]|filter(value => value)|join(', ') %}
                    {% if venueAddress %}
                        <a href="https://www.google.com/maps/search/?api=1&query={{ venueAddress|url_encode }}" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-x-1 text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
                            Open in Google Maps
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-3.5">
                                <path d="M11 3a1 1 0 1 0 0 2h2.586l-6.293 6.293a1 1 0 1 0 1.414 1.414L15 6.414V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z" />
                                <path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z" />
                            </svg>
                        </a>
                    {% endif %}
                {% else %}
                    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">Location not available.</p>
                {% endif %}
            </div>
        </div>

        <div class="mt-8 rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-800">
            <div class="border-b border-gray-200 px-6 py-4 dark:border-white/10">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{{ lineupLabel }}</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2">
                <div class="border-b border-gray-200 px-6 py-4 sm:border-b-0 sm:border-r dark:border-white/10">
                    <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">{{ match.homeTeam }}</h3>
                    <ul role="list" class="mt-2 divide-y divide-gray-100 dark:divide-white/10">
                        {% for player in homePlayers %}
                            <li class="flex items-center gap-x-3 py-3">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-xs font-semibold text-white">
                                    {{ player.firstName|first }}{{ player.lastName|first }}
                                </span>
                                <span class="text-sm font-medium text-gray-900 dark:text-white">{{ player.firstName }} {{ player.lastName }}</span>
                                {% if player.ranking is defined and player.ranking %}
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-500 dark:bg-white/10 dark:text-gray-400">{{ player.ranking }}</span>
                                {% endif %}
                            </li>
                        {% else %}
                            <li class="py-3 text-sm text-gray-500 dark:text-gray-400">No players available.</li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="px-6 py-4">
                    <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">{{ match.awayTeam }}</h3>
                    <ul role="list" class="mt-2 divide-y divide-gray-100 dark:divide-white/10">
                        {% for player in awayPlayers %}
                            <li class="flex items-center gap-x-3 py-3">
                                <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gray-500 text-xs font-semibold text-white">
                                    {{ player.firstName|first }}{{ player.lastName|first }}
                                </span>
                                <span class="text-sm font-medium text-gray-900 dark:text-white">{{ player.firstName }} {{ player.lastName }}</span>
                                {% if player.ranking is defined and player.ranking %}
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs font-medium text-gray-500 dark:bg-white/10 dark:text-gray-400">{{ player.ranking }}</span>
                                {% endif %}
                            </li>
                        {% else %}
                            <li class="py-3 text-sm text-gray-500 dark:text-gray-400">No players available.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-8 rounded-xl border border-gray-200 bg-white shadow-xs dark:border-white/10 dark:bg-gray-800">
            <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4 dark:border-white/10">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-white">
                    {{ match.ongoing ? 'Live results' : 'Results' }}
                </h2>
                {% if match.ongoing %}
                    <span class="inline-flex items-center gap-x-1.5 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300">
                        <span class="size-1.5 animate-pulse rounded-full bg-indigo-500"></span>
                        Updating
                    </span>
                {% endif %}
            </div>
            {% if results is not empty %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-white/10">
                        <thead>
                            <tr>
                                <th scope="col" class="py-3.5 pr-3 pl-6 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Set number</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Home player</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Away player</th>
                                <th scope="col" class="py-3.5 pr-6 pl-3 text-right text-xs font-semibold tracking-wide text-gray-500 uppercase dark:text-gray-400">Score</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-white/10">
                            {% for result in results %}
                                <tr>
                                    <td class="py-3 pr-3 pl-6 text-sm font-medium text-gray-900 dark:text-white">{{ result.position }}</td>
                                    <td class="px-3 py-3 text-sm text-gray-700 dark:text-gray-300">{{ result.home }}</td>
                                    <td class="px-3 py-3 text-sm text-gray-700 dark:text-gray-300">{{ result.away }}</td>
                                    <td class="py-3 pr-6 pl-3 text-right font-mono text-sm font-semibold {{ result.homeSets > result.awaySets ? 'text-indigo-600 dark:text-indigo-400' : 'text-gray-900 dark:text-white' }}">{{ result.homeSets }}-{{ result.awaySets }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="px-6 py-6">
                    {% if match.ongoing %}
                        <p class="text-sm text-gray-500 dark:text-gray-400">Live results will be shown here.</p>
                    {% elseif match.past %}
                        <p class="text-sm text-gray-500 dark:text-gray-400">No detailed results available for this match.</p>
                    {% else %}
                        <p class="text-sm text-gray-500 dark:text-gray-400">This match has not been played yet.</p>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
