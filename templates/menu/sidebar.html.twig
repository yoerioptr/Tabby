{% extends 'knp_menu_base.html.twig' %}

{% import 'menu/_macros.html.twig' as menu %}

{% block root %}
    <ul role="list" class="flex flex-1 flex-col gap-y-7">
        <li>
            <ul role="list" class="-mx-2 space-y-1">
                {% for child in item.children %}
                    <li>{{ menu.nav_link(child, matcher.isCurrent(child))|raw }}</li>
                {% endfor %}
            </ul>
        </li>
        {% if is_granted('ROLE_ADMIN') %}
            <li>
                <div class="text-xs/6 font-semibold text-gray-400">Actions</div>
                <ul role="list" class="-mx-2 mt-2 space-y-1">
                    {{ knp_menu_render('actions', {'template': 'menu/actions.html.twig'}) }}
                </ul>
            </li>
        {% endif %}
    </ul>
{% endblock %}
